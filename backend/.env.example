# ==============================================================
# El Rincón del Mate - Variables de Entorno de Ejemplo (Backend)
# ==============================================================

PORT=3000
NODE_ENV=development

# Clave secreta para firma y verificación de JWT (mínimo 32 caracteres)
JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_32_caracteres_aqui

# Correo oficial del Administrador Dueño (obligatorio)
ADMIN_EMAIL=admin@tudominio.com

# URL del Frontend (CORS)
FRONTEND_URL=http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://127.0.0.1:4200

# Base de datos PostgreSQL (Prisma)
DATABASE_URL=postgresql://usuario:password@localhost:5432/el_rincon_del_mate?schema=public
DIRECT_URL=postgresql://usuario:password@localhost:5432/el_rincon_del_mate?schema=public

# Supabase Auth & Storage (Opcional en desarrollo local, obligatorio en producción)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_publica_anon_de_supabase
SUPABASE_SERVICE_ROLE_KEY=tu_clave_maestra_service_role_de_supabase
SUPABASE_STORAGE_BUCKET=el-rincon-del-mate

# Notificaciones por Correo Electrónico (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion_google


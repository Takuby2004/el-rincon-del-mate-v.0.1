# ===================================================
# 🌿 El Rincón del Mate - Variables de Entorno de Ejemplo
# Copia este archivo a `.env` y asigna tus propios valores
# ===================================================

PORT=3000
NODE_ENV=development

# Conexión a Base de Datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/el_rincon_del_mate?schema=public"
DIRECT_URL="postgresql://usuario:password@localhost:5432/el_rincon_del_mate?schema=public"

# Clave Secreta para Tokens JWT (Mínimo 32 caracteres criptográficos)
# Generar en terminal con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="reemplaza_esta_clave_con_un_hash_aleatorio_de_minimo_32_caracteres"

# URL del Frontend (CORS)
FRONTEND_URL="http://localhost:4200"
ALLOWED_ORIGINS="http://localhost:4200,http://localhost:3000"

# Credenciales para el usuario Administrador inicial (Seed)
ADMIN_EMAIL="admin@elrincondelmate.com"
ADMIN_PASSWORD="DefineAquiUnaContrasenaSegura_2026!"

# Notificaciones por Correo Electrónico (Nodemailer / SMTP)
# Si se dejan en blanco, el sistema usará una cuenta de prueba en Ethereal Email para desarrollo
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="tu_correo@gmail.com"
SMTP_PASS="tu_contraseña_de_aplicacion"
EMAIL_FROM="El Rincón del Mate <notificaciones@elrincondelmate.com>"
